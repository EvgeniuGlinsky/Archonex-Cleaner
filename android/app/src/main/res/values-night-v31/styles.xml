<?xml version="1.0" encoding="utf-8"?>
<!-- The dark theme on Android 12 and up, and it has to exist.

     Resource qualifiers are ranked, and night mode outranks platform version:
     on an API 31 device in dark mode `values-night/styles.xml` wins over
     `values-v31/`, so without this file the system splash there would fall back
     to the theme background and lose everything `values-v31` sets.

     Same splash as the light theme, for the reason given in
     `drawable-v21/launch_background.xml`: the icon does not change colour in
     the dark. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
